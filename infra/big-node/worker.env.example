# Скопировать в worker.env (chmod 600) и вписать токен.
# Токен обязателен: внутри контейнера воркер слушает 0.0.0.0, и без токена к нему мог бы
# обратиться любой контейнер той же docker-сети. Значение — то же, что у шлюза
# (IMG_WORKER_TOKEN) или что передано узлу при регистрации (worker_token).
IMG_WORKER_TOKEN=

# Имя узла, под которым воркер представляется в /status и в журнале; пусть совпадает с
# именем узла в шлюзе (POST /api/v1/nodes). Общее для всех сервисов compose.yml.
IMG_WORKER_NODE=node-c

# Необязательно — значения по умолчанию заданы в compose.yml и в образе:
# IMG_WORKER_LOG_LEVEL=info
# IMG_MINIMAX_EXIT_AFTER_S=120     # 0 — не выходить из процесса после задачи
# IMG_MINIMAX_PLACEMENT=to         # device_map — читать веса сразу на карту
