# Воркер images-api для HiDream-O1-Image (узел с картой на 96 ГБ).
# В образе стек, код воркера и вендорный код HiDream; веса монтируются снаружи только на чтение.
#
# Сборка за прокси: docker compose build --build-arg https_proxy=http://host:port
FROM python:3.12-slim

ENV PIP_NO_CACHE_DIR=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    PIP_DEFAULT_TIMEOUT=120 \
    PYTHONUNBUFFERED=1

# Тот же слой, что в Dockerfile (MiniMax): docker возьмёт его из кэша.
RUN pip install --index-url https://download.pytorch.org/whl/cu128 torch==2.9.1 torchvision==0.24.1

COPY requirements-hidream.txt /tmp/requirements.txt
RUN pip install -r /tmp/requirements.txt

# Вендорный код HiDream (github.com/HiDream-ai/HiDream-O1-Image, коммит a5bc6ef, MIT).
# flash-attn под Blackwell (sm_120) готовыми колёсами не ставится, поэтому пайплайн
# переключается на штатную ветку без него — README HiDream описывает ровно эту правку.
# Математика та же (внимание с 4D-маской через SDPA), медленнее и чуть больше памяти.
COPY hidream_vendor /opt/hidream
RUN sed -i 's/"use_flash_attn": True,/"use_flash_attn": False,/' /opt/hidream/models/pipeline.py \
 && grep -q '"use_flash_attn": False,' /opt/hidream/models/pipeline.py

COPY worker /opt/images-worker
RUN python -m compileall -q /opt/images-worker/images_worker /opt/hidream/models

ENV PYTHONPATH=/opt/images-worker \
    HOME=/tmp \
    HF_HOME=/tmp/hf-home \
    HF_HUB_CACHE=/hf/hub \
    HF_HUB_OFFLINE=1 \
    HF_HUB_DISABLE_TELEMETRY=1 \
    PYTORCH_ALLOC_CONF=expandable_segments:True \
    IMG_WORKER_BACKEND=hidream \
    IMG_WORKER_HOST=0.0.0.0 \
    IMG_WORKER_PORT=8104 \
    IMG_HIDREAM_REPO_DIR=/opt/hidream \
    IMG_HIDREAM_MODEL_PATH=/hf/hub/models--HiDream-ai--HiDream-O1-Image/snapshots/0b0901d99f200389e138c61946af1185f5f49a13

USER 1000:1000
EXPOSE 8104
CMD ["python", "-m", "images_worker"]
