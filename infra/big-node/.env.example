# Переменные подстановки для compose.yml. Скопировать в .env рядом с compose.yml —
# docker compose читает его сам, в контейнеры он не попадает.
#
# UUID карты, которую получают все воркеры комплекта (вида GPU-xxxxxxxx-xxxx-...). Узнать:
#   nvidia-smi --query-gpu=index,uuid,name,memory.total --format=csv
# Обязателен: пока он пуст, любая команда docker compose останавливается с ошибкой.
IMG_GPU_UUID=
