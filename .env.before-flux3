# images-api — пример конфигурации. Скопировать в .env и подставить секреты.

# --- Сервер ---
IMG_HOST=0.0.0.0
IMG_PORT=8010
IMG_LOG_LEVEL=INFO
IMG_LOG_JSON=true
IMG_PUBLIC_BASE_URL=http://192.168.0.60:8010

# --- Безопасность ---
# Первый ключ в списке — админский: только им заводятся и включаются узлы.
# Если IMG_HOST смотрит наружу, а ключей нет, приложение откажется стартовать
# (обход — IMG_ALLOW_INSECURE=true, но лучше просто задать ключ).
IMG_API_KEYS=img-me3CPBgftO8FLX_iUxjMI-zjvXTe41CF,img-X36QgRdXPisDCV5idYXOBqBmRm31npDP
IMG_ALLOW_INSECURE=false
IMG_CORS_ORIGINS=
# Секрет подписи ссылок на картинки: без него <img src> не откроется без заголовка.
IMG_IMAGE_URL_SECRET=B7Wp_kcqwUJ58M2WHU6T-z30KYDvQv0wAvdFGYuVKmU
IMG_IMAGES_REQUIRE_AUTH=true

# --- Общий секрет со всеми воркерами ---
IMG_WORKER_TOKEN=e3K-jtmYBHl4h81wK9AU6sU-nkfHHp5Q

# --- Узлы ---
# base_urls: бэкенд -> адрес воркера. Для nv-02 это локальные концы ssh-туннеля
# (18101..18104), см. /etc/ssh-tunnels/nv02.env.
IMG_NODES_JSON=[{"name":"br-01","kind":"local","base_urls":{"qwen":"http://127.0.0.1:8101","zimage":"http://127.0.0.1:8102","ernie":"http://127.0.0.1:8103","hidream":"http://127.0.0.1:8104","qwen21":"http://127.0.0.1:8105","moss":"http://127.0.0.1:8106"},"vram_reserve_mb":1024,"enabled":true}]

# Диагностика отказов: чей ollama смотреть, чтобы в тексте ошибки было видно,
# кто именно занял карту. Только чтение /api/ps — чужие модели не выгружаем.
IMG_NODE_OLLAMA_URLS={"br-01":"http://127.0.0.1:11434","nv-02":"http://192.168.0.58:11434"}

# --- Политика VRAM (остаточный принцип) ---
# Не хватило карты — ждём в очереди до 10 минут, опрашивая все узлы.
# Не освободилось — задача завершается с error_code=vram_unavailable.
IMG_VRAM_WAIT_TIMEOUT_S=600
IMG_VRAM_POLL_INTERVAL_S=5
# Выгрузка резидентной модели после простоя узла.
IMG_IDLE_UNLOAD_SECONDS=180
# Сторож утечек. ВАЖНО: этот порог должен быть БОЛЬШЕ IMG_IDLE_UNLOAD_SECONDS,
# иначе аварийная ветка срабатывает раньше штатной и обычный простой попадает
# в журнал инцидентов как «залипшая память».
IMG_STUCK_VRAM_SECONDS=300
IMG_GUARD_INTERVAL_S=30
# Разрешить сторожу перезапускать зависший воркер (нужно правило в sudoers).
IMG_ALLOW_WORKER_RESTART=false

# --- Prompt Enhancer ---
# Порядок = порядок попыток. Правило отбора одно: эндпоинт не должен занимать
# VRAM наших двух 3090.
#   1) mdm-ai через туннель :11436 — чужая RTX PRO 6000 96 ГБ, уже используется vedora;
#   2) ollama на nv-02 с cloud-моделью — считается в облаке, локальную VRAM не берёт,
#      но промпты уходят наружу; поменять местами с (1) — одна правка здесь;
#   3) dml через туннель :11435 — поднять, когда починят туннель.
# Не добавлять сюда локальные модели ollama (qwen3.6:27b — это 17.4 ГБ на nv-02)
# и br-01:11434 — они съедят ту самую карту, которую мы бережём.
IMG_PE_ENABLED=true
IMG_PE_ENDPOINTS=[{"base_url":"http://127.0.0.1:11436/v1","model":"qwen3.6:27b","api_key":"ollama","timeout_s":90},{"base_url":"http://192.168.0.58:11434/v1","model":"qwen3.5:cloud","api_key":"ollama","timeout_s":60}]
IMG_PE_TIMEOUT_S=60

# --- OpenAI-совместимый слой ---
# Алиасы gpt-image-1/dall-e-* уходят в эту модель. z-image-turbo — 9 шагов,
# самая безопасная задержка для блокирующего запроса.
IMG_OPENAI_DEFAULT_MODEL=z-image-turbo
IMG_OPENAI_MAX_N=2
IMG_OPENAI_TIMEOUT_S=600

# --- Хранилище ---
IMG_OUTPUT_DIR=/home/user/images-api/outputs
IMG_DB_PATH=/home/user/images-api/data/images.db
IMG_TASK_RETENTION_DAYS=30
IMG_IMAGE_RETENTION_DAYS=90
